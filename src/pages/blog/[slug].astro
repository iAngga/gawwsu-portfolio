---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, cleanId, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({
    params: { slug: cleanId(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, updated, lang, tags, cover } = entry.data;
const back = lang === 'id' ? '← semua tulisan' : '← all posts';
---

<BaseLayout title={title} description={description} lang={lang}>
  <a class="back" href="/blog/">{back}</a>

  <article class="post">
    <header>
      <p class="eyebrow">
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        {updated && <span> · updated {formatDate(updated, lang)}</span>}
        {lang === 'id' && <span> · Bahasa Indonesia</span>}
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {
        tags.length > 0 && (
          <ul class="chips">
            {tags.map((t) => (
              <li>
                <span class="chip small">{t}</span>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <div class="hero-image">
          <Image src={cover} alt="" width={Math.min(cover.width, 1200)} format="webp" />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post header {
    margin-bottom: 28px;
  }
  .eyebrow {
    margin: 0 0 10px;
  }
</style>
