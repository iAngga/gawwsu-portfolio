---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { SOCIALS } from '../data/site';

const doing = [
  { what: 'Linux & infra', detail: 'Docker, self-hosting, Cloudflare Tunnel, monitoring, and keeping one school server with ~70 containers alive.' },
  { what: 'Lab & network admin', detail: 'Eight school computer labs, batch scripts pushed with NetSupport School, MikroTik routers, exam-day setups.' },
  { what: 'Games', detail: 'Unity, game jams, small weird ideas that sometimes get finished. Published as GyroThirteen Labs.' },
  { what: 'Pixel art & 3D', detail: 'Aseprite for sprites, Blender for low-poly props.' },
];

const work = [
  { role: 'IT Support Technician', where: 'Public vocational high school, Bandung', when: 'Nov 2025 – now' },
  { role: 'QA & IT Support', where: 'MASI Technology (IPTV software for hotels)', when: '~6 months' },
  { role: 'IoT Instructor & Researcher', where: 'PT Forit (internship, then staff)', when: '' },
];
---

<BaseLayout title="About" description="About gawwsu (Angga): IT support technician in Bandung, working toward DevOps, making small games on the side.">
  <div class="about">
    <div class="avatar" aria-hidden="true">
      <Logo />
    </div>

    <div>
      <h1>Hi, I'm Angga.</h1>
      <div class="prose">
        <p>
          Online I go by <strong>gawwsu</strong>. I'm an IT support technician from Bandung, Indonesia, working my
          way into DevOps and Linux system administration. Right now I look after eight computer labs and a Docker
          server at a vocational high school, on my own.
        </p>
        <p>
          I self-host things, break them, fix them, and write down how. On the side I make small games and pixel
          art under GyroThirteen Labs. Some blog posts here are written in Bahasa Indonesia.
        </p>
        <p>
          I'm open to junior DevOps, Linux sysadmin, and technical support roles, remote or hybrid.
        </p>
      </div>

      <h2>What I do</h2>
      <dl class="doing">
        {
          doing.map((d) => (
            <div>
              <dt>{d.what}</dt>
              <dd>{d.detail}</dd>
            </div>
          ))
        }
      </dl>

      <h2>Work</h2>
      <dl class="doing">
        {
          work.map((w) => (
            <div>
              <dt>{w.role}</dt>
              <dd>
                {w.where}
                {w.when && <span class="when"> · {w.when}</span>}
              </dd>
            </div>
          ))
        }
      </dl>

      <h2>Find me</h2>
      <ul class="socials">
        {
          SOCIALS.map((s) => (
            <li>
              <span class="label">{s.label}</span>
              <a href={s.url} rel={s.url.startsWith('http') ? 'me noopener' : undefined}>
                {s.handle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    margin-top: 12px;
  }
  .avatar {
    background: var(--surface);
    padding: 28px 22px 16px;
    align-self: start;
    box-shadow: 6px 6px 0 var(--shadow);
  }
  .when {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  h2 {
    margin-top: 1.6em;
  }
  .doing {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .doing dt {
    font-family: var(--font-pixel);
    font-size: 1.1rem;
    color: var(--accent);
  }
  .doing dd {
    margin: 0;
    color: var(--text-dim);
  }
  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .socials li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: baseline;
  }
  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .avatar {
      max-width: 260px;
    }
  }
</style>
