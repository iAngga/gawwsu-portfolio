---
import { SITE, SOCIALS } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer container">
  <div class="rule" aria-hidden="true"></div>
  <div class="row">
    <p>© {year} {SITE.name}. Made with Astro, palette SLSO8.</p>
    <ul>
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.url} rel={s.url.startsWith('http') ? 'me noopener' : undefined}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding-bottom: 36px;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .rule {
    height: 4px;
    margin-bottom: 20px;
    background-image: linear-gradient(90deg, var(--border) 50%, transparent 50%);
    background-size: 12px 4px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
